# 1. Налаштування Telegram-бота (Жодних ID чату вводити НЕ потрібно!)
# Просто вставте токен вашого бота і натисніть /start у самому боті в Telegram —
# бот сам автоматично запам'ятає вас як адміна і надсилатиме вам усі замовлення.
TELEGRAM_BOT_TOKEN=

# (Необов'язково) Якщо хочете дозволити отримувати замовлення лише конкретному нікнейму в Telegram (напр. @my_admin_nick):
TELEGRAM_ADMIN_USERNAME=

# 2. Ключ API Нової Пошти (необов'язково: без нього вже працює вбудований довідник усіх міст і відділень НП та Укрпошти)
NOVA_POSHTA_API_KEY=

# 3. Налаштування Google OAuth (необов'язково)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
